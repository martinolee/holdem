{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holdem",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-11-01",

  // Rebuilds the browser bundle (public/app.js) before `wrangler dev` and `wrangler deploy`.
  "build": {
    "command": "npm run build",
    "watch_dir": "src"
  },

  // The client: index.html + app.js. Unknown paths such as /t/k7m2 fall back to index.html.
  // Only the WebSocket path runs the Worker; everything else is served straight from assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*"]
  },

  // One Durable Object per table. The free plan requires the SQLite storage backend.
  "durable_objects": {
    "bindings": [{ "name": "TABLES", "class_name": "Table" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Table"] }],

  // Table rules. Change and redeploy; tables pick them up the next time they start.
  "vars": {
    "SB": "10",
    "BB": "20",
    "BUYIN": "2000",
    "TURN_SECS": "30"
  },

  "observability": { "enabled": true }
}
