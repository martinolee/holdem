{
  "name": "holdem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=public/app.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && tsc --noEmit -p src/client"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "wrangler": "4.156.2"
  }
}
